{
  "name": "frameshot",
  "description": "FrameShot: Free Screenshot & Full Page Capture — capture, edit, organize, and export screenshots locally in your browser.",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "author": "Unique Labs",
  "license": "UNLICENSED",
  "scripts": {
    "dev": "wxt",
    "build": "wxt build",
    "build:e2e": "cross-env FRAMESHOT_E2E=1 wxt build",
    "zip": "wxt zip",
    "compile": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "npm run build:e2e && playwright test --trace off",
    "check:bundle": "node scripts/check-bundle.mjs .output/chrome-mv3",
    "icons": "node scripts/render-icons.mjs",
    "store:assets": "npm run build:e2e && node scripts/store-assets.mjs && node scripts/store-render.mjs",
    "perf:ui": "node scripts/perf-ui.mjs",
    "store:kit": "npm run build && python3 scripts/build-store-kit.py",
    "website": "node scripts/website/build.mjs",
    "website:assets": "node scripts/website/assets.mjs",
    "website:serve": "node scripts/website/serve.mjs",
    "website:check": "node scripts/website/verify.mjs",
    "postinstall": "wxt prepare"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.0",
    "@radix-ui/react-dialog": "^1.1.0",
    "@radix-ui/react-dropdown-menu": "^2.1.0",
    "@radix-ui/react-popover": "^1.1.0",
    "@radix-ui/react-tooltip": "^1.2.0",
    "gifenc": "1.0.3",
    "idb": "^8.0.0",
    "lucide-react": "^1.70.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@wxt-dev/module-react": "^1.1.3",
    "cross-env": "^7.0.3",
    "fake-indexeddb": "^6.0.0",
    "pdf-lib": "^1.17.1",
    "tailwindcss": "^4.1.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0",
    "vitest": "^5.1.0",
    "wxt": "^0.21.5"
  }
}
